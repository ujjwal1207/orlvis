# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://sharmaujjwal2019:<db_password>@ujjwaldatabase.zraibfy.mongodb.net/orlvis?retryWrites=true&w=majority&appName=Ujjwaldatabase
# Replace <db_password> with your actual MongoDB Atlas password

# JWT Configuration
