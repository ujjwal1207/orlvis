# Render Production Environment Variables
# Copy these values to your Render Web Service Environment tab

# Database Configuration
MONGODB_URI=mongodb+srv://sharmaujjwal2019:YOUR_ACTUAL_PASSWORD@ujjwaldatabase.zraibfy.mongodb.net/orlvis?retryWrites=true&w=majority&appName=Ujjwaldatabase

# JWT Configuration - IMPORTANT: Use a strong, unique secret for production
JWT_SECRET=your_super_secure_production_jwt_secret_minimum_32_characters_long

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URL - Update this after deploying frontend to Render
FRONTEND_URL=https://orlvis-frontend.onrender.com

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Optional: Add monitoring and logging
LOG_LEVEL=info